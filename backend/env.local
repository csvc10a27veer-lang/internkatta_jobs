# Local Development Environment Variables
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/fourie_InternKatta
FRONTEND_URL=http://localhost:5173

# JWT Configuration
JWT_SECRET=local_development_jwt_secret_key_2024_secure_random_string
JWT_EXPIRE=30d

# Email Configuration (for local testing - use your own Gmail credentials)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# PhonePe Configuration (for local testing - use test credentials)
PHONEPE_MERCHANT_ID=your_test_merchant_id
PHONEPE_SALT_KEY=your_test_salt_key
PHONEPE_SALT_INDEX=1
PHONEPE_BASE_URL=https://api-preprod.phonepe.com/apis/pg/checkout
PHONEPE_ENVIRONMENT=UAT

# File Upload Configuration
MAX_FILE_SIZE=10000000
UPLOAD_PATH=./uploads

# Google OAuth Configuration (use your own Google OAuth credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

